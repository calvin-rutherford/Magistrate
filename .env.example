# Database (Postgres)
DATABASE_URL=postgres://omnigent:password@localhost:5432/omnigent_db

# RabbitMQ / Celery
CELERY_BROKER_URL=amqp://omnigent:password@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Django Channels / Redis
CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/1

# Server-only Native Magi provider credentials. Configure at least one catalog
# candidate in production; never add credentials to EXPO_PUBLIC_*. Model,
# capability, price, budget, and failover policy defaults live in the typed
# gateway/app/magi_routing.py catalog. To replace the complete validated catalog, set
# MAGISTRATE_MODEL_ROUTING_CONFIG to one compact magi.model-routing.v1 JSON
# document (normally via a secret/config-file injector, not source control).
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# MAGISTRATE_MODEL_ROUTING_CONFIG={"schema_version":"magi.model-routing.v1",...}
VOICE_STT_PROVIDER=openai
VOICE_STT_MODEL=gpt-4o-mini-transcribe

# Gateway friend-beta boundary. Never put these values in the frontend.
MAGISTRATE_ENV=development
# Single-instance SQLite: set an absolute path outside the release checkout.
# MAGISTRATE_DB_PATH=/var/lib/magistrate/magistrate.sqlite3
# Multi-instance production: PostgreSQL replaces SQLite, while one private shared
# POSIX state volume retains upload/quarantine bytes at the same path everywhere.
# Use TLS and least-privilege database credentials.
# MAGISTRATE_DATABASE_URL=postgresql://magistrate:password@db.internal:5432/magistrate?sslmode=verify-full
# MAGISTRATE_STATE_DIR=/var/lib/magistrate
MAGISTRATE_BOOTSTRAP_SECRET=replace-with-a-long-random-value
# Production required: MAGISTRATE_SECRET_KEY=<generated-fernet-key>
MAGISTRATE_BOOTSTRAP_USER_ID=default_user
MAGISTRATE_SESSION_SCOPES=read,account,providers,notifications,voice,command
# Explicitly enable only after issuing per-person grants with the operator CLI.
# The safe grant default is read,account,notifications; command/voice requires
# an acknowledged shared-runtime risk and is not tenant isolation.
MAGISTRATE_FRIEND_BETA_ENABLED=false
MAGISTRATE_CORS_ORIGINS=http://localhost:8081
# Development only; leave unset/false for production.
MAGISTRATE_DEV_AUTO_SESSION=false
# Phase 1 production cutover. These are mutually exclusive in deployment:
# native provider/API/SQLite on, terminal/Herdr/Pi captain compatibility off.
MAGISTRATE_NATIVE_CHAT_ENABLED=true
MAGISTRATE_LEGACY_CHAT_ENABLED=false
# Direct Expo builds use the same values. The guarded deployment script derives
# these public booleans from the server flags automatically.
EXPO_PUBLIC_MAGI_NATIVE_CHAT_ENABLED=true
EXPO_PUBLIC_MAGI_LEGACY_CHAT_ENABLED=false
# Optional PATH for the explicit, command-authorized Firstmate delegation and
# decision-answer tools. Normal startup and reads never invoke these commands.
# Every entry must be an absolute existing root/service-owned directory with no
# symlink or non-sticky world-writable path component. When unset, Gateway
# validates its service PATH the same way.
# MAGISTRATE_FIRSTMATE_TOOL_PATH=/opt/firstmate/bin:/usr/local/bin:/usr/bin
# Optional account/runtime HOME for those explicit action subprocesses. It must
# be an absolute existing root/service-owned directory, safely contain FM_HOME,
# and have no symlink or unsafe world-writable path component. When unset,
# Gateway accepts only FM_HOME's direct parent after applying the same checks.
# MAGISTRATE_FIRSTMATE_RUNTIME_HOME=/var/lib/magistrate-runtime
# FM_HOME is operational state, not executable code. Install the reviewed pin
# with scripts/install_firstmate_producer.sh, then select its distinct immutable
# code root. Required mode fails startup/deploy closed unless the home-local
# producer activation and outbox validate.
# FM_HOME=/var/lib/firstmate
# MAGISTRATE_FIRSTMATE_ROOT=/var/lib/magistrate-code/firstmate-producer/2af0d17014cb2e244aa441bfe6df16c4f630475b
MAGISTRATE_FIRSTMATE_CAPTAIN_REQUIRED=false
# Legacy exact Pi semantic ownership channel, retained only for rollback. Native
# Magi chat never initializes or invokes it. Keep it explicitly off in normal
# Phase 1 operation; enable it only together with legacy chat during rollback.
# Replace <uid> with the actual same-UID Gateway/captain-Pi service identity.
# The private runtime is one filesystem boundary: directory 0700 and key,
# socket, and any journal 0600. Gateway creates the key; never print/commit it.
MAGISTRATE_PI_OWNERSHIP_ENABLED=false
MAGISTRATE_PI_RUNTIME_DIR=/run/user/<uid>/magistrate
MAGISTRATE_PI_IPC_KEY_PATH=/run/user/<uid>/magistrate/pi-ownership.key
MAGISTRATE_PI_ADAPTER_SOCKET=/run/user/<uid>/magistrate/pi-ownership.sock
MAGISTRATE_PI_ADAPTER_JOURNAL=/run/user/<uid>/magistrate/pi-ownership.journal
MAGISTRATE_PI_ADAPTER_UID=<uid>
MAGISTRATE_PI_CAPABILITY_TTL_SECONDS=120
MAGISTRATE_PI_CONNECT_TIMEOUT_SECONDS=1
MAGISTRATE_PI_RESPONSE_TIMEOUT_SECONDS=20
MAGISTRATE_PI_RECOVERY_SECONDS=3

# Public HTTPS origin used to build provider callback URLs.
MAGISTRATE_OAUTH_CALLBACK_BASE_URL=https://gateway.example.invalid

# Customer repository access uses a least-privilege GitHub App. Values come
# from the GitHub App provider console; see docs/github-app-activation.md.
# Leave the entire block unset until activation (reported as BLOCKED_EXTERNAL).
# GITHUB_APP_ID=<numeric-app-id-from-github>
# GITHUB_APP_SLUG=<app-slug-from-github>
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/magistrate-github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=<random-secret-at-least-32-characters>
# MAGISTRATE_GITHUB_APP_CALLBACK_BASE_URL=https://gateway.example.invalid
# Exact comma-separated native/web return URLs (no wildcard origins).
# MAGISTRATE_GITHUB_APP_REDIRECT_URIS=magistrate://prs,https://app.example.invalid/prs

# Set the Expo client variable to an HTTPS gateway in production.
# EXPO_PUBLIC_GATEWAY_URL=https://gateway.example.invalid/api/v1

# Billing and credits. The committed catalog has no fake/live Stripe prices;
# paid Checkout stays BLOCKED_EXTERNAL until the activation runbook in
# docs/billing-and-credits.md is completed with an external protected catalog.
# MAGISTRATE_BILLING_CATALOG_PATH=/etc/magistrate/billing-catalog.json
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
MAGISTRATE_BILLING_RETURN_ORIGINS=https://app.example.invalid,magistrate://chat

# Optional verified execution inventory consumed by /api/v1/execution/capabilities.
# Profiles keep harness, provider, model, and variant separate. Credentials are
# entered through Magistrate Settings and stored encrypted; never put secrets here.
# MAGISTRATE_EXECUTION_INVENTORY={"harnesses":[{"id":"pi","label":"Pi","provider":"openai-codex","verified":true,"models":[{"id":"gpt-5.6-luna","label":"GPT-5.6 Luna","variant":"default","profile_id":"pi:default","auth":{"required":false,"credential_key":"openai-codex"}}]}]}

# Public-SaaS provider-neutral isolated execution. Default-off; enabling
# replaces shared local Firstmate intake and fails startup closed unless every
# required backend/mTLS/resource setting is valid. See docs/hosted-execution.md.
MAGISTRATE_HOSTED_EXECUTION_ENABLED=false
# MAGISTRATE_WORKER_IMAGE=registry.example/firstmate-worker@sha256:<digest>
# MAGISTRATE_WORKER_GATEWAY_URL=https://gateway.internal.example
# MAGISTRATE_ISOLATION_BACKEND_URL=https://isolation.internal.example
# MAGISTRATE_GITHUB_TOKEN_BROKER_URL=https://github-broker.internal.example
# MAGISTRATE_ISOLATION_CLIENT_CERT=/run/secrets/magistrate/client.crt
# MAGISTRATE_ISOLATION_CLIENT_KEY=/run/secrets/magistrate/client.key
# MAGISTRATE_ISOLATION_CA=/run/secrets/magistrate/ca.crt
# MAGISTRATE_WORKER_IDENTITY_KEY=<at-least-32-random-bytes>
# MAGISTRATE_WORKER_NETWORK_HOSTS=gateway.internal.example,github.com,api.github.com
# MAGISTRATE_GITHUB_PERMISSIONS=contents:write,pull_requests:write
# MAGISTRATE_WORKER_MAX_GLOBAL=20
# MAGISTRATE_WORKER_MAX_PER_TENANT=2
# MAGISTRATE_WORKER_CPU_MILLIS=2000
# MAGISTRATE_WORKER_MEMORY_MIB=2048
# MAGISTRATE_WORKER_WORKSPACE_MIB=8192
# MAGISTRATE_WORKER_DEADLINE_SECONDS=3600
# MAGISTRATE_WORKER_CLEANUP_SECONDS=300
# MAGISTRATE_WORKER_POLL_SECONDS=5

# Django configuration
SECRET_KEY=dev-secret-key
DEBUG=True
