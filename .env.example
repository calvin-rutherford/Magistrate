# Native Gateway development example, NOT a deployable production environment.
# Copy privately to gateway/.env (0600), then use explicit environment loading.
# Production policy and operational release gates: docs/production-security-operations.md.
MAGISTRATE_ENV=development
MAGISTRATE_CORS_ORIGINS=http://localhost:8081
MAGISTRATE_BOOTSTRAP_SECRET=replace-with-a-long-random-value
MAGISTRATE_BOOTSTRAP_USER_ID=default_user
MAGISTRATE_SESSION_SCOPES=read,account,providers,notifications,voice,command
MAGISTRATE_DEV_AUTO_SESSION=false

# Production requires MAGISTRATE_ENV=production, exact HTTPS origins, a random
# bootstrap secret >=32 characters and a generated Fernet key. Do not reuse keys.
# MAGISTRATE_SECRET_KEY=<generated-fernet-key>
# Configure exactly one persistent backend, outside the release checkout.
# SQLite is single-instance only:
# MAGISTRATE_DB_PATH=/var/lib/magistrate/magistrate.sqlite3
# Multi-instance PostgreSQL uses TLS/least-privilege database credentials and a
# private shared POSIX state volume at the same path on every Gateway instance.
# MAGISTRATE_DATABASE_URL=postgresql://magistrate:password@db.internal:5432/magistrate?sslmode=verify-full
# MAGISTRATE_STATE_DIR=/var/lib/magistrate
# Set only after verifying a restorable managed snapshot for this release:
# MAGISTRATE_POSTGRES_BACKUP_CONFIRMED=true

# Private objects must never overlap the public avatar root.
# MAGISTRATE_OBJECT_STORAGE_DIR=/var/lib/magistrate/private_objects
# MAGISTRATE_CHAT_UPLOAD_DIR is the legacy private-root alias.
# MAGISTRATE_AVATAR_DIR=/var/lib/magistrate/avatars
# MAGISTRATE_UPLOAD_SIGNING_KEY=<independent-32-byte-or-longer-rotation-key>
# Optional scanner argv (no shell), receiving the object path as final argument:
# MAGISTRATE_UPLOAD_SCAN_COMMAND='/usr/bin/clamdscan --no-summary'
# MAGISTRATE_UNATTACHED_UPLOAD_TTL_SECONDS=86400
# MAGISTRATE_ATTACHED_UPLOAD_TTL_SECONDS=2592000
MAGISTRATE_UPLOAD_USER_BYTES=262144000
MAGISTRATE_UPLOAD_USER_COUNT=500
MAGISTRATE_UPLOAD_GLOBAL_BYTES=5368709120
MAGISTRATE_UPLOAD_GLOBAL_COUNT=10000
MAGISTRATE_MAX_INFLIGHT_REQUESTS=32
# MAGISTRATE_METRICS_TOKEN=<independent-random-operator-scrape-token>

# Server-only Native Magi provider credentials. Configure at least one catalog
# candidate in production; NEVER add credentials to EXPO_PUBLIC_*.
# Model/capability/price/budget/failover authority: gateway/app/magi_routing.py.
# To replace the complete validated catalog, provide one compact JSON document.
# Retired MAGISTRATE_MAGI_MODEL_PROVIDER/MODEL/PROVIDER_URL are not selectors.
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=<server-only-key>
# GOOGLE_API_KEY=<server-only-key>
# MAGISTRATE_MODEL_ROUTING_CONFIG={"schema_version":"magi.model-routing.v1",...}
MAGISTRATE_PROVIDER_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
VOICE_STT_PROVIDER=openai
VOICE_STT_MODEL=gpt-4o-mini-transcribe

# Safe grant default: read,account,notifications. Restricted local command/voice
# requires an acknowledged shared-runtime risk; hosted mode instead requires
# the complete fail-closed isolation configuration below.
MAGISTRATE_FRIEND_BETA_ENABLED=false

# Native Chat is the only production conversation architecture. There are no
# selectable legacy/Pi transports. Remove obsolete chat/ownership flags entirely.
# Historical data remains for an operator-approved migration, not a runtime switch.
# Firstmate executable PATH must contain only approved absolute trusted dirs.
# MAGISTRATE_FIRSTMATE_TOOL_PATH=/opt/firstmate/bin:/usr/local/bin:/usr/bin
# MAGISTRATE_FIRSTMATE_RUNTIME_HOME=/var/lib/magistrate-runtime
# FM_HOME=/var/lib/firstmate
# Install/verify the exact reviewed pin with scripts/install_firstmate_producer.sh.
# MAGISTRATE_FIRSTMATE_ROOT=/var/lib/magistrate-code/firstmate-producer/2af0d17014cb2e244aa441bfe6df16c4f630475b
MAGISTRATE_FIRSTMATE_CAPTAIN_REQUIRED=false

# OAuth connection configuration is separate from provider login audiences;
# see docs/provider-sign-in.md and docs/oauth-security.md.
MAGISTRATE_OAUTH_CALLBACK_BASE_URL=https://gateway.example.invalid

# Customer repository access uses a least-privilege GitHub App; see
# docs/github-app-activation.md. Leave unset until external activation.
# GITHUB_APP_ID=<numeric-app-id-from-github>
# GITHUB_APP_SLUG=<app-slug-from-github>
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/magistrate-github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=<random-secret-at-least-32-characters>
# MAGISTRATE_GITHUB_APP_CALLBACK_BASE_URL=https://gateway.example.invalid
# MAGISTRATE_GITHUB_APP_REDIRECT_URIS=magistrate://prs,https://app.example.invalid/prs

# Billing activation requires an external protected catalog with real prices;
# the committed catalog deliberately cannot activate paid Checkout.
# See docs/billing-and-credits.md.
# MAGISTRATE_BILLING_CATALOG_PATH=/etc/magistrate/billing-catalog.json
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
MAGISTRATE_BILLING_RETURN_ORIGINS=https://app.example.invalid,magistrate://chat

# Public build metadata (never credentials). Real production values are required
# by EAS preflight; placeholders do NOT constitute publication evidence.
# EXPO_PUBLIC_GATEWAY_URL=https://gateway.your-domain.com/api/v1
# EXPO_PUBLIC_PRIVACY_URL=https://your-domain.com/privacy
# EXPO_PUBLIC_SUPPORT_URL=https://your-domain.com/support
# APPLE_TEAM_ID=<operator-approved-10-character-team-id>
# Google iOS client and reversed scheme must be configured together:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<client>.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.<client>

# Optional reviewed inventory; never put credential material in this JSON.
# Profiles keep harness/provider/model/variant separate. Credentials entered
# through Settings stay encrypted; see docs/harness-model-switching.md.
# MAGISTRATE_EXECUTION_INVENTORY=<operator-verified-execution-inventory-json>

# Public-SaaS provider-neutral isolated execution. Default-off; enabling replaces
# shared local Firstmate intake and fails startup closed unless every required
# backend/mTLS/resource setting is valid. See docs/hosted-execution.md.
MAGISTRATE_HOSTED_EXECUTION_ENABLED=false
# MAGISTRATE_WORKER_IMAGE=registry.example/firstmate-worker@sha256:<digest>
# MAGISTRATE_WORKER_GATEWAY_URL=https://gateway.internal.example
# MAGISTRATE_ISOLATION_BACKEND_URL=https://isolation.internal.example
# MAGISTRATE_GITHUB_TOKEN_BROKER_URL=https://github-broker.internal.example
# MAGISTRATE_ISOLATION_CLIENT_CERT=/run/secrets/magistrate/client.crt
# MAGISTRATE_ISOLATION_CLIENT_KEY=/run/secrets/magistrate/client.key
# MAGISTRATE_ISOLATION_CA=/run/secrets/magistrate/ca.crt
# MAGISTRATE_WORKER_IDENTITY_KEY=<at-least-32-random-bytes>
# MAGISTRATE_WORKER_NETWORK_HOSTS=gateway.internal.example,github.com,api.github.com
# MAGISTRATE_GITHUB_PERMISSIONS=contents:write,pull_requests:write
# MAGISTRATE_WORKER_MAX_GLOBAL=20
# MAGISTRATE_WORKER_MAX_PER_TENANT=2
# MAGISTRATE_WORKER_CPU_MILLIS=2000
# MAGISTRATE_WORKER_MEMORY_MIB=2048
# MAGISTRATE_WORKER_WORKSPACE_MIB=8192
# MAGISTRATE_WORKER_DEADLINE_SECONDS=3600
# MAGISTRATE_WORKER_CLEANUP_SECONDS=300
# MAGISTRATE_WORKER_POLL_SECONDS=5
