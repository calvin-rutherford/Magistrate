# Database (Postgres)
DATABASE_URL=postgres://omnigent:password@localhost:5432/omnigent_db

# RabbitMQ / Celery
CELERY_BROKER_URL=amqp://omnigent:password@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Django Channels / Redis
CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/1

# LLM Providers (Add the key for the provider you want to use)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
VOICE_STT_PROVIDER=openai
VOICE_STT_MODEL=gpt-4o-mini-transcribe
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_MODEL=gemini/gemini-1.5-pro

# Optional verified execution inventory consumed by /api/v1/execution/capabilities.
# Profiles keep harness, provider, model, and variant separate. Credentials are
# entered through Magistrate Settings and stored encrypted; never put secrets here.
# MAGISTRATE_EXECUTION_INVENTORY={"harnesses":[{"id":"pi","label":"Pi","provider":"openai-codex","verified":true,"models":[{"id":"gpt-5.6-luna","label":"GPT-5.6 Luna","variant":"default","profile_id":"pi:default","auth":{"required":false,"credential_key":"openai-codex"}}]}]}

# Django configuration
SECRET_KEY=dev-secret-key
DEBUG=True
