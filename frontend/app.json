{
  "expo": {
    "name": "Magistrate",
    "slug": "magistrate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "magistrate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "io.magistrate.cockpit",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Magistrate requires microphone access for voice interactions.",
        "NSSpeechRecognitionUsageDescription": "Magistrate uses speech recognition to transcribe your voice commands.",
        "NSPhotoLibraryUsageDescription": "Magistrate allows uploading profile photos.",
        "NSCameraUsageDescription": "Magistrate allows taking profile photos.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "io.magistrate.cockpit",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Magistrate to capture audio only while you use Voice Mode.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aedf2c07-8f71-4e31-9e6e-7968f30479b1"
      }
    },
    "owner": "melkezics-team"
  }
}
