{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_MAGI_NATIVE_CHAT_ENABLED": "true",
        "EXPO_PUBLIC_MAGI_LEGACY_CHAT_ENABLED": "false"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_MAGI_NATIVE_CHAT_ENABLED": "true",
        "EXPO_PUBLIC_MAGI_LEGACY_CHAT_ENABLED": "false"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MAGI_NATIVE_CHAT_ENABLED": "true",
        "EXPO_PUBLIC_MAGI_LEGACY_CHAT_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
