{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"content_free": {"format": "%(message)s"}},
  "handlers": {"stdout": {"class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "content_free"}},
  "loggers": {
    "magistrate.operations": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "CRITICAL", "propagate": false}
  }
}
