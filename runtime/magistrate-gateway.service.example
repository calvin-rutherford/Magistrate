# TEMPLATE: review paths/resource budgets and install as a user unit.
# No Herdr, worker, Pi or Docker lifecycle is managed by this service.
[Unit]
Description=Magistrate provider-native Gateway
After=network-online.target

[Service]
WorkingDirectory=%h/releases/magistrate/gateway
EnvironmentFile=%h/releases/magistrate/gateway/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/releases/magistrate/gateway/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --log-config logging.json --limit-concurrency 64 --backlog 128 --timeout-keep-alive 5 --ws-max-size 65536 --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Add only the operator-approved Firstmate state/tool-write roots needed by
# explicit actions. Never make the entire home/repository tree writable.
ReadWritePaths=%h/.local/state/magistrate
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=default.target
